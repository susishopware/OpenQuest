# OpenRouter key, used for the vision models and for Jev (TypeSafe) via OpenRouter.
OPENROUTER_API_KEY=

# Optional overrides (comma separated model ids).
# VISION_MODELS=google/gemini-3.8-flash,google/gemini-3.5-flash-lite
# VISION_ESCALATION_MODEL=openai/gpt-6-luna
# JEV_MODEL=typesafe/jev-1.13
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter

# ===== Docker Compose (docker-compose.yml, see docs/docker.md) =====
# Compose reads this file for variable substitution and passes it to the api and dashboard containers.
# Inside the containers, database and storage addresses are fixed to the compose services (db, minio),
# so localhost values for the backend keep working for `dotnet run` on the host.

# Host ports (container ports stay the same)
# WEB_PORT=3000
# API_PORT=5076
# DASHBOARD_PORT=8787
# DB_PORT=5432
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001

# postgis/postgis is amd64 only and runs emulated on Apple Silicon. Native arm64 alternative:
# DB_IMAGE=imresamu/postgis:17-3.5
# DB_PLATFORM=linux/arm64

# The api container runs in Development by default (random JWT key, generated admin password).
# Outside Development Jwt__Key and Admin__Password are required (see apps/api/README.md).
# ASPNETCORE_ENVIRONMENT=Development
